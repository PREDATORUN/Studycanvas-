{
  "name": "StudyCanvas Codespace",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "postCreateCommand": "sudo npm install --global @openai/codex && if [ -f package-lock.json ]; then npm ci; elif [ -f package.json ]; then npm install; fi",
  "forwardPorts": [
    3000,
    5173
  ],
  "portsAttributes": {
    "3000": {
      "label": "App preview (Next.js)",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "App preview (Vite)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GitHub.vscode-pull-request-github"
      ]
    }
  }
}
