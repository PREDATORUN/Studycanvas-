rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // All mutations go through verified server APIs. Public profile reads are forbidden.
  match /users/{uid} {
   allow read: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
   allow write: if false;
   match /tasks/{id} { allow read: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; allow write: if false; }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
